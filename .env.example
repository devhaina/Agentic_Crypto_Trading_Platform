# =============================================================================
# Agentiva — Agentic Crypto Trading Platform
# Local development environment template.
#
#   cp .env.example .env     then edit .env
#
# .env is git-ignored. NEVER commit real credentials.
# In production these values come from a secret manager (Azure Key Vault /
# AWS Secrets Manager / Kubernetes Secrets) and NOT from a .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=agentiva-platform
ASPNETCORE_ENVIRONMENT=Development
TZ=UTC

# Logical deployment name used in telemetry resource attributes.
AGENTIVA_ENVIRONMENT=local

# -----------------------------------------------------------------------------
# TRADING MODE  --  BACKTEST | PAPER | LIVE
#
# Enforced at the execution boundary (Execution Service), not merely in config.
# Development MUST stay on PAPER. Switching to LIVE additionally requires
# TRADING__ALLOWLIVE=true and a non-empty exchange credential set, so that a
# single stray edit cannot start trading real funds.
# -----------------------------------------------------------------------------
TRADING__MODE=PAPER
TRADING__ALLOWLIVE=false

# Global kill switch. When true, no new orders are admitted anywhere.
TRADING__KILLSWITCHENABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL (relational, database-per-service)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agentiva
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=postgres
# Host port mapping (container always listens on 5432).
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# TimescaleDB (market time-series)
# -----------------------------------------------------------------------------
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=agentiva
TIMESCALE_PASSWORD=change_me_local_only
TIMESCALE_DB=market_db
TIMESCALE_HOST_PORT=5433

# -----------------------------------------------------------------------------
# Redis (cache / ephemeral state — never the source of truth)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_local_only
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# RabbitMQ (domain event bus)
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=agentiva
RABBITMQ_PASSWORD=change_me_local_only
RABBITMQ_VHOST=/
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
LOKI_URL=http://loki:3100
SERILOG__MINIMUMLEVEL=Information

PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_local_only
LOKI_HOST_PORT=3100

# -----------------------------------------------------------------------------
# Identity / JWT
#
# Local development uses a symmetric signing key for convenience. Production
# MUST use an OIDC provider with asymmetric keys (see docs/security/identity.md).
# Generate a local key:  openssl rand -base64 64
# -----------------------------------------------------------------------------
JWT__ISSUER=https://identity.agentiva.local
JWT__AUDIENCE=agentiva-api
JWT__SIGNINGKEY=REPLACE_WITH_openssl_rand_base64_64_OUTPUT_AT_LEAST_64_BYTES
JWT__ACCESSTOKENMINUTES=15
JWT__REFRESHTOKENDAYS=7

# -----------------------------------------------------------------------------
# Service host port mappings (container port is always 8080)
# -----------------------------------------------------------------------------
GATEWAY_HOST_PORT=8080
IDENTITY_HOST_PORT=8081
MARKETDATA_HOST_PORT=8082
TRADING_HOST_PORT=8083
RISK_HOST_PORT=8084
EXECUTION_HOST_PORT=8085
PORTFOLIO_HOST_PORT=8086
STRATEGY_HOST_PORT=8087
BACKTESTING_HOST_PORT=8088
RECONCILIATION_HOST_PORT=8089
NOTIFICATION_HOST_PORT=8090
AUDIT_HOST_PORT=8091
CONFIGURATION_HOST_PORT=8092
AI_HOST_PORT=8000
FRONTEND_HOST_PORT=4200

# -----------------------------------------------------------------------------
# Exchange — Binance
#
# PHASE 1 DOES NOT CONNECT TO AN EXCHANGE. Leave these blank.
# Phase 2+ uses the Binance *Testnet* only. Real keys are never placed here.
#
# Required key restrictions when you eventually issue them:
#   * Enable Spot Trading
#   * DISABLE withdrawals
#   * Restrict to specific egress IPs
#   * Never reuse across environments
#
# Only the Execution Service receives these variables (see docker-compose.yml).
# -----------------------------------------------------------------------------
BINANCE__USETESTNET=true
BINANCE__RESTBASEURL=https://testnet.binance.vision
BINANCE__WSBASEURL=wss://testnet.binance.vision/ws
BINANCE__APIKEY=
BINANCE__APISECRET=

# Symbols the market data service subscribes to (MVP scope).
MARKETDATA__SYMBOLS=BTCUSDT,ETHUSDT
MARKETDATA__TIMEFRAMES=15m,1h
# A tick older than this marks market data stale and blocks trading.
MARKETDATA__STALENESSTHRESHOLDSECONDS=30

# -----------------------------------------------------------------------------
# Risk policy defaults (deterministic hard limits)
#
# These are seeded into risk_db as the default policy. They are intentionally
# conservative. Changing them is an audited operation.
# -----------------------------------------------------------------------------
RISK__MAXRISKPERTRADEPERCENT=0.5
RISK__MAXDAILYLOSSPERCENT=2.0
RISK__MAXPORTFOLIOEXPOSUREPERCENT=50.0
RISK__MAXPOSITIONSIZEQUOTE=1000
RISK__MAXOPENPOSITIONS=5
RISK__MAXASSETCONCENTRATIONPERCENT=25.0
RISK__MINCONFIDENCE=0.60
RISK__REQUIRESTOPLOSS=true
RISK__REQUIRETAKEPROFIT=true
RISK__SLIPPAGEASSUMPTIONPERCENT=0.05
RISK__TAKERFEEPERCENT=0.1

# -----------------------------------------------------------------------------
# AI agent platform
#
# The AI platform holds NO exchange credentials and has NO execution tools.
# It reaches market/portfolio data only through the gateway's read-only routes.
# Leaving the LLM key blank runs the platform in deterministic "stub" mode,
# which is the Phase 1 default and keeps the repo runnable with no vendor account.
# -----------------------------------------------------------------------------
AI_LLM_PROVIDER=stub
AI_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_AGENT_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096
AI_GATEWAY_BASE_URL=http://api-gateway:8080

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_API_BASE_URL=http://localhost:8080
