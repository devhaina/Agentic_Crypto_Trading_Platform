{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "//": [
    "Local defaults only. Every value here is overridden by environment",
    "variables in docker-compose and by the secret manager in deployed",
    "environments. Secrets are intentionally BLANK: a committed password,",
    "even a development one, trains people to expect credentials in this",
    "file and is the first thing an attacker greps a repository for."
  ],
  "ConnectionStrings": {
    "Timescale": "Host=localhost;Port=5433;Database=market_db;Username=agentiva;Password=",
    "Redis": "localhost:6379"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "agentiva",
    "Password": "",
    "VirtualHost": "/",
    "PrefetchCount": 16,
    "MaxDeliveryAttempts": 3,
    "RetryDelaysSeconds": [
      5,
      30,
      120
    ],
    "DeclareTopologyOnStartup": true
  },
  "MarketData": {
    "Symbols": "BTCUSDT,ETHUSDT",
    "Timeframes": "15m,1h",
    "StalenessThresholdSeconds": 30,
    "StalenessCheckIntervalSeconds": 5
  },
  "Binance": {
    "//": "Public market data only. No API key or secret: see docs/architecture/known-limitations.md.",
    "UseTestnet": true,
    "WsBaseUrl": "wss://stream.testnet.binance.vision/ws",
    "OrderBookDepth": 20,
    "OrderBookUpdateIntervalMs": 1000,
    "InitialReconnectDelaySeconds": 1,
    "MaxReconnectDelaySeconds": 30,
    "ExchangeName": "binance"
  },
  "Jwt": {
    "Issuer": "https://identity.agentiva.local",
    "Audience": "agentiva-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Trading": {
    "//": "PAPER by default. LIVE additionally requires AllowLive=true.",
    "Mode": "Paper",
    "AllowLive": false,
    "KillSwitchEnabled": false,
    "QuoteAsset": "USDT"
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "Loki": {
    "Url": ""
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",
  "AllowedHosts": "*"
}
