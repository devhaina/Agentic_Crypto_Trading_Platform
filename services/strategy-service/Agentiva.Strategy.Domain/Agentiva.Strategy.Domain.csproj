<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Agentiva.Strategy.Domain</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    No EF Core, no ASP.NET, no messaging, no Npgsql — the same discipline
    Agentiva.Risk.Domain applies to position sizing. The indicator maths and
    the strategies' entry/exit decisions themselves moved out to
    Agentiva.BuildingBlocks.TradingRules in Phase 8, so the Backtesting
    Service can replay the exact same compiled rules this service runs live.
    What stays here is StrategyDefinition/Signal: the persisted identity a
    signal is attributed to, not the decision logic that produced it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\building-blocks\Agentiva.BuildingBlocks.Common\Agentiva.BuildingBlocks.Common.csproj" />
    <ProjectReference Include="..\..\..\src\building-blocks\Agentiva.BuildingBlocks.Domain\Agentiva.BuildingBlocks.Domain.csproj" />

    <!-- Solely for the EventTypes routing-key constants; see the remarks on
         the equivalent reference in Agentiva.Trading.Domain. -->
    <ProjectReference Include="..\..\..\contracts\events\Agentiva.Contracts.Events\Agentiva.Contracts.Events.csproj" />
  </ItemGroup>

</Project>
